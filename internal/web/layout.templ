package web

import "strconv"

templ head(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title }</title>
		<link rel="icon" type="image/svg+xml" href={ asset("favicon.svg") }/>
		<link rel="preload" href="/static/vendor/inter-latin.woff2" as="font" type="font/woff2" crossorigin/>
		<link rel="stylesheet" href={ asset("vendor/pico.min.css") }/>
		<link rel="stylesheet" href={ asset("app.css") }/>
		<script src={ asset("vendor/htmx.min.js") }></script>
		<script defer src={ asset("vendor/alpine.min.js") }></script>
	</head>
}

// Login is the login page. Usernames and passwords are the user's ntfy account.
templ Login(username, errMsg string) {
	<!DOCTYPE html>
	<html lang="en">
		@head("Log in · gonotifier")
		<body>
			@iconSprite()
			<main class="container login">
				<div class="brand">
					@Icon("bell")
					<span>gonotifier</span>
				</div>
				<form class="panel login-panel" method="post" action="/login">
					if errMsg != "" {
						<div class="form-errors" role="alert">
							@Icon("alert")
							<div><p>{ errMsg }</p></div>
						</div>
					}
					<label class="field">
						<span class="field-label">Username</span>
						<input type="text" name="username" value={ username } autocomplete="username" autocapitalize="none" required autofocus/>
					</label>
					<label class="field">
						<span class="field-label">Password</span>
						<input type="password" name="password" autocomplete="current-password" required/>
					</label>
					<button type="submit" class="btn btn-primary">Log in</button>
					<p class="hint">Log in with your ntfy account.</p>
				</form>
			</main>
		</body>
	</html>
}

// Page is the full dashboard: layout, upcoming list, events, history, dialogs.
templ Page(p pageData) {
	<!DOCTYPE html>
	<html lang="en">
		@head("gonotifier")
		<body
			x-data="{ pending: null }"
			@open-dialog.window="$refs.dialog.open || $refs.dialog.showModal()"
			@close-dialog.window="$refs.dialog.close()"
			@htmx:confirm.window="if ($event.detail.question) { $event.preventDefault(); pending = $event.detail; $refs.confirm.showModal() }"
		>
			@iconSprite()
			<header class="topbar">
				<div class="container topbar-inner">
					<a href="/" class="brand">
						@Icon("bell")
						<span>gonotifier</span>
					</a>
					<div class="topbar-actions">
						<span class="muted small user-name">{ p.Username }</span>
						<form method="post" action="/logout">
							<button type="submit" class="icon-btn" title="Log out" aria-label="Log out">
								@Icon("log-out")
							</button>
						</form>
						<button type="button" class="btn btn-primary" hx-get="/events/new" hx-target="#dialog-content">
							@Icon("plus")
							<span>New event</span>
						</button>
					</div>
				</div>
			</header>
			<main class="container">
				<section class="panel">
					<div class="panel-head">
						<h2>Upcoming</h2>
						<span class="muted small">Next 30 days</span>
					</div>
					<div id="upcoming">
						@Upcoming(p)
					</div>
				</section>
				<section class="panel">
					<div class="panel-head">
						<h2>Events <span class="count" id="events-count">{ strconv.Itoa(len(p.Events)) }</span></h2>
						@FeedLink(p.FeedPath)
					</div>
					<div id="event-list" class="rows">
						@EventList(p)
					</div>
					<div class="empty">
						@Icon("calendar")
						<p>No events yet</p>
						<button type="button" class="btn btn-ghost" hx-get="/events/new" hx-target="#dialog-content">
							@Icon("plus")
							<span>Create your first event</span>
						</button>
					</div>
				</section>
				@history(p.History)
			</main>
			// Add/edit dialog: htmx loads the form, then the server's open-dialog trigger shows it.
			<dialog id="dialog" x-ref="dialog" class="modal" @click.self="$el.close()">
				<article id="dialog-content"></article>
			</dialog>
			// Styled replacement for the browser's confirm() used by hx-confirm.
			<dialog x-ref="confirm" class="modal modal-sm" @click.self="$el.close()" @close="pending = null">
				<article>
					<div class="modal-body">
						<h3 class="modal-title" x-text="(pending && pending.elt.dataset.confirmTitle) || 'Delete event?'">Delete event?</h3>
						<p class="muted" x-text="pending && pending.question"></p>
					</div>
					<div class="modal-foot">
						<button type="button" class="btn btn-ghost" @click="$refs.confirm.close()">Cancel</button>
						<button type="button" class="btn btn-danger" @click="pending && pending.issueRequest(true); $refs.confirm.close()" x-text="(pending && pending.elt.dataset.confirmAction) || 'Delete'">Delete</button>
					</div>
				</article>
			</dialog>
			@toast()
		</body>
	</html>
}

// FeedLink is the user's secret calendar feed URL, with a button to replace it.
templ FeedLink(path string) {
	<div id="feed" class="feed">
		<a href={ templ.URL(path) } class="link-quiet" title="Your private calendar feed: copy the link into Google Calendar → Add calendar → From URL">
			@Icon("rss")
			<span>Calendar feed</span>
		</a>
		<button
			type="button"
			class="icon-btn"
			title="New calendar link"
			aria-label="Replace calendar link"
			hx-post="/feed/reset"
			hx-target="#feed"
			hx-swap="outerHTML"
			hx-confirm="The current link stops working: calendars subscribed to it need the new one."
			data-confirm-title="Replace calendar link?"
			data-confirm-action="Replace"
		>
			@Icon("rotate")
		</button>
	</div>
}

templ history(items []HistoryView) {
	<details class="panel">
		<summary class="panel-head">
			<h2>Recently sent</h2>
			@Icon("chevron")
		</summary>
		if len(items) > 0 {
			<ul class="list">
				for _, h := range items {
					<li>
						<span class="list-icon">
							@Icon("send")
						</span>
						<div class="grow">
							<div class="item-title">{ h.EventName }</div>
							<div class="muted small truncate">{ h.Message }</div>
						</div>
						<span class="rel">{ h.SentAt }</span>
					</li>
				}
			</ul>
		} else {
			<div class="empty empty-static">
				@Icon("send")
				<p>No notifications sent yet</p>
			</div>
		}
	</details>
}

// toast shows messages the server sends as: HX-Trigger: {"show-toast": {"message": "…", "type": "success"}}
templ toast() {
	<div
		class="toast"
		role="status"
		aria-live="polite"
		x-data="{ show: false, message: '', type: 'success', timer: null }"
		@show-toast.window="message = $event.detail.message; type = $event.detail.type || 'success'; show = true; clearTimeout(timer); timer = setTimeout(() => show = false, 3000)"
		:class="type"
		x-show="show"
		x-transition:enter="toast-enter"
		x-transition:enter-start="toast-from"
		x-transition:enter-end="toast-to"
		x-transition:leave="toast-leave"
		x-transition:leave-start="toast-to"
		x-transition:leave-end="toast-from"
		style="display: none"
	>
		<span x-show="type === 'success'">
			@Icon("check")
		</span>
		<span x-show="type !== 'success'">
			@Icon("alert")
		</span>
		<span x-text="message"></span>
	</div>
}

// Icon renders a symbol from iconSprite.
templ Icon(name string) {
	<svg class="icon" aria-hidden="true"><use href={ "#i-" + name }></use></svg>
}

// iconSprite holds the line icons (Lucide, ISC licence) referenced by Icon.
templ iconSprite() {
	<svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true">
		<symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></symbol>
		<symbol id="i-plus" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="M12 5v14"></path></symbol>
		<symbol id="i-pencil" viewBox="0 0 24 24"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></symbol>
		<symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></symbol>
		<symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></symbol>
		<symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></symbol>
		<symbol id="i-alert" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path></symbol>
		<symbol id="i-calendar" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></symbol>
		<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></symbol>
		<symbol id="i-repeat" viewBox="0 0 24 24"><path d="m17 2 4 4-4 4"></path><path d="M3 11v-1a4 4 0 0 1 4-4h14"></path><path d="m7 22-4-4 4-4"></path><path d="M21 13v1a4 4 0 0 1-4 4H3"></path></symbol>
		<symbol id="i-rss" viewBox="0 0 24 24"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></symbol>
		<symbol id="i-send" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></symbol>
		<symbol id="i-chevron" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></symbol>
		<symbol id="i-log-out" viewBox="0 0 24 24"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></symbol>
		<symbol id="i-rotate" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></symbol>
	</svg>
}
